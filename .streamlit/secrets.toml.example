# Copy this file to .streamlit/secrets.toml (Git ignores that file) and fill in both values.
# Supabase dashboard -> Project Settings -> Data API: Project URL
supabase_url = "https://your-project.supabase.co"
# Supabase dashboard -> Project Settings -> API Keys: the Publishable key (sb_publishable_...)
# or the legacy "anon public" key. Never the Secret / service_role key: it bypasses
# Row Level Security, so the app refuses to connect with it.
supabase_key = "sb_publishable_your-key"
